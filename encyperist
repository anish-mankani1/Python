#Reverse a Stack You are given a stack of integers. Your task is to reverse the order of the elements in the stack using only stack operations (push and pop) and without using any additional data structures. Ex. stack = [1, 2, 3, 4, 5] reverse Stack(stack) print(stack) Output should be [5, 4, 3, 2, 1].


def insertAtBottom(stack, item):
	if isEmpty(stack):
		push(stack, item)
	else:
		temp = pop(stack)
		insertAtBottom(stack, item)
		push(stack, temp)


def reverse(stack):
	if not isEmpty(stack):
		temp = pop(stack)
		reverse(stack)
		insertAtBottom(stack, temp)

def createStack():
	stack = []
	return stack


def isEmpty(stack):
	return len(stack) == 0

def push(stack, item):
	stack.append(item)

def pop(stack):

	if(isEmpty(stack)):
		print("Stack Underflow ")
		exit(1)

	return stack.pop()

def prints(stack):
	for i in range(len(stack)-1, -1, -1):
		print(stack[i], end=' ')
	print()
stack = createStack()
push(stack, str(4))
push(stack, str(3))
push(stack, str(2))
push(stack, str(1))
print("Original Stack ")
prints(stack)

reverse(stack)

print("Reversed Stack ")
prints(stack)


